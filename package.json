{
  "name": "lacuna",
  "private": true,
  "version": "0.2.13",
  "packageManager": "bun@1.4.3",
  "type": "module",
  "main": "electron/dist-electron/main.js",
  "description": "Lacuna - a local-only FSRS-6 flashcard revision application.",
  "author": "TJ7755",
  "homepage": "https://github.com/TJ7755/Lacuna#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TJ7755/Lacuna.git"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "preview": "bun run build && vite preview",
    "typecheck": "bun run typecheck:web && bun run typecheck:server && bun run typecheck:electron",
    "typecheck:web": "bun check -b",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "ai:gateway:spike": "bun server/ai/localSpike.ts",
    "ai:invites": "node scripts/ai-invites.mjs",
    "typecheck:electron": "tsc -p electron/tsconfig.json --noEmit && tsc -p electron/tsconfig.preload.json --noEmit && tsc -p electron/tsconfig.mcp.json --noEmit",
    "typecheck:ai-mcp": "bun run --cwd tooling/lacuna-ai-mcp typecheck",
    "test": "vitest run",
    "test:ci:unit": "vitest run --maxWorkers=1",
    "test:ai-mcp": "bun run --cwd tooling/lacuna-ai-mcp test",
    "test:coverage": "vitest run src/course/path.test.ts src/course/unlock.test.ts src/fsrs/session.test.ts src/pages/learn/practiceQueue.test.tsx src/db/lineageDiff.test.ts --coverage --maxWorkers=1",
    "test:coverage:recovery": "vitest run --config tests/config/vitest.recovery.config.ts --coverage --maxWorkers=1",
    "test:coverage:risk": "vitest run --config tests/config/vitest.risk.config.ts --coverage --maxWorkers=1",
    "test:e2e:web": "playwright test -c tests/config/playwright.web.config.ts",
    "test:e2e:electron-ai": "bun run electron:prepare && playwright test -c tests/config/playwright.electron-ai.config.ts",
    "test:e2e:electron-macos-smoke": "playwright test -c tests/config/playwright.electron-macos-smoke.config.ts",
    "test:e2e:electron-package": "playwright test -c tests/config/playwright.electron-performance.config.ts",
    "perf:audit": "bun scripts/performance-audit.ts",
    "perf:audit:heavy": "bun run build:assets && node scripts/performance-heavy/build.mjs && node artifacts/performance/run.mjs",
    "perf:audit:web-interactions": "playwright test -c tests/config/playwright.web.config.ts tests/e2e/first-interaction-latency.spec.ts --project=chromium --workers=1",
    "perf:audit:electron-package": "bun scripts/electron-package-audit.ts",
    "perf:check:electron-package": "bun scripts/electron-package-audit.ts --asar release/win-unpacked/resources/app.asar --check",
    "perf:check": "bun scripts/performance-audit.ts --assets-only",
    "build:assets": "vite build",
    "test:watch": "vitest",
    "lint": "eslint src server electron tests api scripts tooling \"*.config.ts\" eslint.config.js --max-warnings=0",
    "lint:ai-mcp": "bun run --cwd tooling/lacuna-ai-mcp lint",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"electron/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\" \"*.cjs\" \".prettierrc\"",
    "build:mcp": "node electron/mcp/build.mjs",
    "smoke:ai-mcp": "node scripts/ai-mcp-smoke.mjs",
    "build:ai-mcp": "bun run --cwd tooling/lacuna-ai-mcp build",
    "ai:mcp": "node tooling/lacuna-ai-mcp/dist/index.js",
    "release:scenario": "node scripts/release-scenario.mjs",
    "release": "node scripts/release.mjs",
    "changelog:release": "node scripts/changelog.mjs",
    "changelog:check": "node scripts/changelog.mjs --check",
    "icons:generate": "bun scripts/generate-icons.ts",
    "electron:prepare": "node scripts/prepare-electron-build.mjs",
    "electron:dev": "bun run electron:prepare && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "bun run electron:prepare && vite build --mode production --base ./ && electron-builder --config electron/electron-builder.yml --publish never",
    "electron:build:win": "bun run electron:prepare && vite build --mode production --base ./ && electron-builder --win --x64 --config electron/electron-builder.yml --publish never",
    "electron:build:linux": "bun run electron:prepare && vite build --mode production --base ./ && electron-builder --linux --x64 --config electron/electron-builder.yml --publish never",
    "electron:build:mac": "bun run electron:prepare && vite build --mode production --base ./ && electron-builder --mac --arm64 --config electron/electron-builder.yml --publish never"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "@emnapi/core": "1.10.0",
    "@emnapi/runtime": "1.10.0",
    "@napi-rs/wasm-runtime": "1.2.4",
    "lodash-es": "4.18.1",
    "fast-uri": "3.1.8",
    "http-cache-semantics": "4.3.0",
    "shell-quote": "1.12.0",
    "katex": "0.19.0"
  },
  "devDependencies": {
    "@ai-sdk/gateway": "^4.0.103",
    "@ai-sdk/google": "^4.0.87",
    "@ai-sdk/openai-compatible": "^3.0.62",
    "@electron/asar": "4.3.1",
    "@eslint/js": "^10.0.0",
    "@modelcontextprotocol/client": "2.3.0",
    "@modelcontextprotocol/server": "2.3.0",
    "@napi-rs/wasm-runtime": "1.2.4",
    "@open-spaced-repetition/binding": "^0.5.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "@vitest/coverage-v8": "5.0.3",
    "ai": "^7.0.127",
    "concurrently": "^10.0.5",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "dompurify": "^3.4.16",
    "electron": "^44.5.1",
    "electron-builder": "^26.17.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "highlight.js": "^11.10.0",
    "html5-qrcode": "^2.3.8",
    "katex": "^0.19.0",
    "mathjs": "^15.2.0",
    "mermaid": "^12.1.0",
    "motion": "^14.0.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "rehype-highlight": "^7.0.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "sql.js": "^1.14.1",
    "tailwindcss": "4.3.3",
    "ts-fsrs": "^5.2.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "5.0.3",
    "wait-on": "^9.5.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
